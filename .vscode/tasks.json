{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check",
      "type": "shell",
      "command": "make",
      "args": ["check"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "make",
      "args": ["test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$rustc"
    },
    {
      "label": "fmt",
      "type": "shell",
      "command": "make",
      "args": ["fmt"],
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "make",
      "args": ["lint"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "make",
      "args": ["build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$rustc"
    },
    {
      "label": "run",
      "type": "shell",
      "command": "make",
      "args": ["run"],
      "isBackground": true,
      "problemMatcher": "$rustc"
    }
  ]
}
