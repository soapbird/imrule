SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
MAKEFLAGS += --warn-undefined-variables --no-builtin-rules
.DEFAULT_GOAL := help

BIN := {{bin}}
PREFIX ?= $(HOME)/.local
ARGS ?=

.PHONY: help setup fmt fmt-check lint test check build run clean install

help: ## 타깃 목록
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z0-9_-]+:.*## / {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

setup: ## 개발 도구 설치 (rustfmt, clippy)
	rustup component add rustfmt clippy

fmt: ## 포맷 적용
	cargo fmt --all

fmt-check: ## 포맷 검사 (파일 수정 없음)
	cargo fmt --all -- --check

lint: ## clippy 린트 (경고를 에러로)
	cargo clippy --all-targets --all-features --locked -- -D warnings

test: ## 테스트
	cargo test --all-features --locked

check: fmt-check lint test ## CI 게이트: 포맷 검사 + 린트 + 테스트

build: ## 릴리스 빌드
	cargo build --release --locked

run: ## 실행 (make run ARGS="--help")
	cargo run -- $(ARGS)

clean: ## 빌드 산출물 삭제
	cargo clean

install: build ## $(PREFIX)/bin에 설치
	install -d "$(PREFIX)/bin"
	install -m 0755 "target/release/$(BIN)" "$(PREFIX)/bin/$(BIN)"
