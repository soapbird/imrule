SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
MAKEFLAGS += --warn-undefined-variables --no-builtin-rules
.DEFAULT_GOAL := help

BIN := {{bin}}
VERSION := $(shell cat VERSION)
GIT_SHA := $(shell git rev-parse --short HEAD 2>/dev/null)
REGISTRY ?= docker.lowapple.io
IMAGE ?= $(REGISTRY)/$(BIN)
PLATFORMS ?= linux/amd64,linux/arm64
PORT ?= {{port}}

.PHONY: help setup fmt fmt-check lint test check build run clean docker-build docker-push deploy

help: ## 타깃 목록
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z0-9_-]+:.*## / {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

setup: ## 개발 도구 설치 (rustfmt, clippy)
	rustup component add rustfmt clippy

fmt: ## 포맷 적용
	cargo fmt --all

fmt-check: ## 포맷 검사 (파일 수정 없음)
	cargo fmt --all -- --check

lint: ## clippy 린트 (경고를 에러로)
	cargo clippy --all-targets --all-features --locked -- -D warnings

test: ## 테스트
	cargo test --all-features --locked

check: fmt-check lint test ## CI 게이트: 포맷 검사 + 린트 + 테스트

build: ## 릴리스 빌드
	cargo build --release --locked --bin $(BIN)

run: ## 로컬 서버 실행 (127.0.0.1:$(PORT))
	{{env_prefix}}HOST=127.0.0.1 {{env_prefix}}PORT=$(PORT) cargo run --bin $(BIN)

clean: ## 빌드 산출물 삭제
	cargo clean

docker-build: ## 로컬 플랫폼 이미지 빌드
	docker build -t $(IMAGE):$(VERSION) -t $(IMAGE):latest -t $(IMAGE):$(GIT_SHA) .

docker-push: docker-build ## 이미지 푸시
	docker push --all-tags $(IMAGE)

deploy: ## 멀티 아키텍처 이미지 빌드 후 푸시
	docker buildx build --platform $(PLATFORMS) -t $(IMAGE):$(VERSION) -t $(IMAGE):latest -t $(IMAGE):$(GIT_SHA) --push .
