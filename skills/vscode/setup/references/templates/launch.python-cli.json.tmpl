{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "{{pkg}}: CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "{{pkg}}",
      "args": ["--help"],
      "cwd": "${workspaceFolder}/{{pydir}}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: 현재 파일",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}/{{pydir}}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
